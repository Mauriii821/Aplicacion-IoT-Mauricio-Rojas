# Copia este archivo como ".env" y completa tus datos. El .env NO se sube a GitHub.
# --- Broker MQTT Mosquitto (en esta misma VM, con TLS) ---
# El nodo y el puente corren en la VM, así que se conectan a localhost.
MQTT_HOST=localhost
MQTT_PORT=8883
# Certificado de la CA creado por broker/instalar_broker.sh
MQTT_CA=/etc/mosquitto/certs/ca.crt
# Usuario del nodo (sensores/actuadores)
MQTT_USER=raspbian01
MQTT_PASS=clave_del_nodo
# Usuario del puente (solo lectura)
PUENTE_MQTT_USER=puente
PUENTE_MQTT_PASS=clave_del_puente
# Clave para firmar mensajes. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Debe ser LA MISMA en la app (local.properties -> hmac.key)
HMAC_KEY=pega_aqui_la_clave_generada
DEVICE_ID=raspbian01
INTERVALO_S=5
# --- Base de datos AWS RDS ---
DB_HOST=database-2.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=pi
DB_PASS=nueva_clave_segura
DB_NAME=iot_db
# Certificado de AWS RDS para conexión cifrada (opcional, recomendado):
# wget https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=global-bundle.pem
