# Copia este archivo como ".env" y completa tus datos. El .env NO se sube a GitHub.
# --- Broker MQTT Mosquitto (en esta misma VM, con TLS) ---
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_CA=/etc/mosquitto/certs/ca.crt
# Usuario del nodo (sensores/actuadores)
MQTT_USER=raspbian01
MQTT_PASS=clave_del_nodo
# Usuario del puente (solo lectura)
PUENTE_MQTT_USER=puente
PUENTE_MQTT_PASS=clave_del_puente
# Clave para firmar mensajes. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Debe ser LA MISMA en la app (local.properties -> hmac.key)
HMAC_KEY=pega_aqui_la_clave_generada
DEVICE_ID=raspbian01
INTERVALO_S=5
# --- Amazon DynamoDB ---
# Las credenciales de AWS van en ~/.aws/credentials (NO aquí)
AWS_REGION=us-east-1
# --- API HTTPS para la app ---
API_PORT=5000
API_CERT=certs_api/server.crt
API_KEY=certs_api/server.key
