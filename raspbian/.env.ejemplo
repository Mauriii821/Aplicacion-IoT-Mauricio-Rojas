# Copia este archivo como ".env" y completa tus datos. El .env NO se sube a GitHub.

# --- AWS IoT Core (broker MQTT en la nube) ---
# Lo muestra crear_reglas_iot.py, o la consola: IoT Core -> Configuración -> Punto de enlace
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
# Archivos del kit de conexión del "objeto" (thing) descargado de AWS IoT
IOT_ROOT_CA=/home/pi/aws-iot-certs/AmazonRootCA1.pem
IOT_CERT=/home/pi/aws-iot-certs/xxxx-certificate.pem.crt
IOT_KEY=/home/pi/aws-iot-certs/xxxx-private.pem.key
# Debe coincidir con el client permitido en la política de IoT
IOT_CLIENT_ID=raspbian01
DEVICE_ID=raspbian01
INTERVALO_S=5

# Clave para firmar los mensajes (integridad). Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=pega_aqui_la_clave_generada

# --- AWS (DynamoDB y publicación de comandos) ---
# Las credenciales van en ~/.aws/credentials (Learner Lab -> AWS Details), NO aquí
AWS_REGION=us-east-1

# --- API HTTPS para la app ---
API_PORT=5000
API_CERT=certs_api/server.crt
API_KEY=certs_api/server.key
