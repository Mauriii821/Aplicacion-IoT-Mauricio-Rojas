<?xml version="1.0" encoding="utf-8"?>
<!-- TODO el tráfico de la app va cifrado: no se permite HTTP sin cifrar.
     Para la API de la VM se confía en nuestra propia CA (res/raw/ca_mosquitto.crt),
     la misma que firma el certificado del broker Mosquitto.
     Si cambia la IP de la VM, cámbiala también aquí. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">172.20.10.2</domain>
        <trust-anchors>
            <certificates src="@raw/ca_mosquitto" />
        </trust-anchors>
    </domain-config>
</network-security-config>
