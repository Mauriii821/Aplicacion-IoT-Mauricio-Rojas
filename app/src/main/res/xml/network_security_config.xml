<?xml version="1.0" encoding="utf-8"?>
<!-- TODO el tráfico de la app va cifrado: no se permite HTTP sin cifrar.
     Se confía en las CA del sistema y en nuestra propia CA (res/raw/ca_api.crt),
     que firma el certificado HTTPS de la API de la Raspberry.
     Como no depende de la IP, sirve en la VM y en la Raspberry física. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ca_api" />
        </trust-anchors>
    </base-config>
</network-security-config>
