<?xml version="1.0" encoding="utf-8"?>
<!-- Por defecto TODO el tráfico debe ir cifrado (HTTPS / TLS).
     Solo se permite HTTP sin cifrar hacia el servidor PHP de la red local.
     Si cambias la IP del servidor, cámbiala también aquí. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.157</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
